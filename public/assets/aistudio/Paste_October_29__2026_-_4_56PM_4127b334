      <div>{children}</div>
    </div>
  );
}

/** Turns the LAST word of a sentence into the italic-serif accent used in headlines. */
export function EmLast({ text }: { text: string }) {
  const t = text.trim();
  const i = t.lastIndexOf(' ');
  if (i < 0) return <em>{t}</em>;
  return <>{t.slice(0, i + 1)}<em>{t.slice(i + 1)}</em></>;
}


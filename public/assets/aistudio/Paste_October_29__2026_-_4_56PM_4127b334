/* pricing */
.goal-tabs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 10px; }
.goal { padding: 18px 20px; border-radius: 22px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); text-align: left; transition: box-shadow .25s, background-color .25s; }
.goal:hover { box-shadow: inset 0 0 0 1.5px rgb(var(--ink) / .35); }
.goal[aria-selected="true"] { background: rgb(var(--ink)); color: #fff; box-shadow: none; }
.goal strong { display: block; font: 700 18px / 1.2 var(--font-display); letter-spacing: -.02em; }
.goal span { display: block; margin-top: 4px; font-size: 14px; color: rgb(var(--muted)); }
.goal[aria-selected="true"] span { color: #ffffffb3; }
.offers { display: grid; gap: 16px; margin-top: 18px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.offers.single { grid-template-columns: minmax(0, 640px); }
.offer { position: relative; display: flex; flex-direction: column; padding: clamp(26px, 3vw, 40px); border-radius: 30px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); }
.offer.is-featured { background: rgb(var(--ink)); color: #fff; box-shadow: none; }
.offer-badge { position: absolute; top: 20px; right: 20px; padding: 7px 14px; border-radius: 999px; background: rgb(var(--brand)); color: rgb(var(--ink)); font-size: 13px; font-weight: 700; }
.offer h3 { font: 800 28px / 1.05 var(--font-display); letter-spacing: -.035em; padding-right: 110px; }
.offer-desc { margin-top: 8px; color: rgb(var(--muted)); font-size: 16px; }
.is-featured .offer-desc, .is-featured .offer-who { color: #ffffffb3; }
.offer-price { margin-top: 24px; font: 800 clamp(40px, 5vw, 56px) / 1 var(--font-display); letter-spacing: -.045em; }
.offer-price small { font: 600 18px var(--font-body); letter-spacing: 0; opacity: .6; }
.offer-note { margin-top: 6px; font-size: 14px; font-weight: 700; color: rgb(var(--accent)); }
.is-featured .offer-note { color: rgb(var(--brand)); }
.offer-who { margin-top: 16px; color: rgb(var(--ink-2)); font-size: 16px; }
.offer-list { display: grid; gap: 10px; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgb(var(--line)); }
.is-featured .offer-list { border-color: #ffffff2b; }
.offer-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 15.5px; line-height: 1.35; }
.offer-list svg { flex: none; margin-top: 2px; color: rgb(var(--accent)); }
.is-featured .offer-list svg { color: rgb(var(--brand)); }
.drawer { margin-top: 12px; border-top: 1px solid rgb(var(--line)); }
.is-featured .drawer { border-color: #ffffff2b; }
.drawer button { display: flex; width: 100%; align-items: center; justify-content: space-between; min-height: 48px; font-weight: 600; font-size: 15.5px; }
.drawer button svg { transition: transform .3s var(--ease-out); }
.drawer ul { padding-bottom: 8px; }
.drawer li { padding: 3px 0; color: rgb(var(--muted)); font-size: 15px; }
.is-featured .drawer li { color: #ffffffb3; }
.offer .btn-studio { margin-top: auto; align-self: flex-start; }
.offer-spacer { height: 26px; flex: none; }
.offer.is-featured .btn-studio { background: #fff; color: rgb(var(--ink)); }
.pricing-foot { margin-top: 20px; color: rgb(var(--muted)); font-size: 15px; }

/* why us */
.why-wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 70px); align-items: start; }
.chips { display: flex; flex-wrap: wrap; gap: 10px; }
.chip { padding: 14px 22px; border-radius: 999px; font: 700 clamp(17px, 1.8vw, 22px) / 1 var(--font-display); letter-spacing: -.02em; background: var(--tone); transition: transform .4s var(--ease-out); }
.chip:hover { transform: translateY(-3px) rotate(-1.5deg); }

/* process */
.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; counter-reset: s; }
.step-card { padding: 24px 24px 26px; border-radius: 24px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
.step-card:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px transparent, var(--shadow-card); }
.step-num { display: inline-flex; align-items: center; min-height: 38px; padding: 0 16px; border-radius: 999px; background: rgb(var(--ink)); color: #fff; font-size: 14px; font-weight: 700; }
.step-card h3 { margin-top: 18px; font: 700 22px / 1.12 var(--font-display); letter-spacing: -.025em; }
.step-card p { margin-top: 8px; color: rgb(var(--ink-2)); font-size: 16px; line-height: 1.5; }

/* testimonials */
.quotes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.quotes > li { display: flex; }
.quotes > li:first-child { grid-row: span 2; }
.quote { display: flex; flex-direction: column; gap: 18px; width: 100%; padding: 28px; border-radius: 26px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out); }
.quote:hover { transform: translateY(-4px) rotate(-.6deg); box-shadow: inset 0 0 0 1px transparent, var(--shadow-card); }
.quote.is-lead { background: rgb(var(--butter)); box-shadow: none; }
.quote-mark { display: block; height: 30px; color: rgb(var(--coral)); font: 400 italic 72px / .8 var(--font-serif); }
.quote blockquote { font-size: 18px; line-height: 1.5; }
.quote.is-lead blockquote { font: 700 clamp(26px, 3vw, 38px) / 1.1 var(--font-display); letter-spacing: -.03em; }
.quote figcaption { display: flex; align-items: center; gap: 12px; margin-top: auto; }
.quote-avatar { display: grid; place-items: center; flex: none; width: 52px; height: 52px; border-radius: 14px; background: rgb(var(--peach)); font: 800 16px var(--font-display); }
.quote.is-lead .quote-avatar { background: #fff; }
.quote-name { display: block; font-size: 16px; font-weight: 700; }
.quote-role { display: block; color: rgb(var(--muted)); font-size: 14px; }

/* faq */
.faq { display: grid; gap: 10px; max-width: 860px; margin-inline: auto; }
.faq-item { border-radius: 20px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); transition: box-shadow .3s; }
.faq-item.is-open { box-shadow: inset 0 0 0 1.5px rgb(var(--ink)); }
.faq-q { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 14px 18px 14px 22px; text-align: left; font: 700 18px / 1.3 var(--font-display); letter-spacing: -.015em; }
.faq-icon { display: grid; flex: none; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: rgb(var(--surface-2)); transition: transform .35s var(--ease-out), background-color .3s, color .3s; }
.faq-item.is-open .faq-icon { background: rgb(var(--ink)); color: #fff; transform: rotate(45deg); }
.faq-a { padding: 0 22px 22px; max-width: 62ch; color: rgb(var(--ink-2)); }
.faq-item.is-note { background: transparent; box-shadow: inset 0 0 0 1px rgb(var(--line)); }
.faq-item.is-note .faq-q { font: 600 15px / 1.3 var(--font-body); color: rgb(var(--muted)); min-height: 52px; }
.faq-item.is-note .faq-a { font-size: 14.5px; color: rgb(var(--muted)); }

/* final cta */
.final { position: relative; isolation: isolate; overflow: hidden; padding: clamp(56px, 8vw, 112px) clamp(24px, 5vw, 80px); border-radius: 36px; background: linear-gradient(135deg, #ffe3d1, #fff1bd); text-align: center; }
.final::before, .final::after { content: ""; position: absolute; z-index: -1; border-radius: 50%; will-change: transform; }
.final::before { left: -12%; top: -35%; width: 62%; height: 95%; background: radial-gradient(closest-side, rgb(var(--blob-a) / .95), rgb(var(--blob-a) / .4) 55%, rgb(var(--blob-a) / 0)); animation: drift-a 16s ease-in-out infinite alternate; }
.final::after { right: -12%; bottom: -40%; width: 62%; height: 105%; background: radial-gradient(closest-side, rgb(var(--blob-b) / .95), rgb(var(--blob-b) / .4) 55%, rgb(var(--blob-b) / 0)); animation: drift-b 20s ease-in-out infinite alternate; }
.final .h-section { max-width: 18ch; margin-inline: auto; }
.final .lead { margin-inline: auto; }
.final-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 34px; }

/* footer */
.site-foot { padding: 56px 0 40px; color: rgb(var(--muted)); font-size: 15px; }
.foot-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 36px; }
.foot-col h4 { margin: 0 0 8px; color: rgb(var(--ink)); font: 700 15px var(--font-display); }
.foot-col a { display: block; padding: 5px 0; transition: color .2s; }
.foot-col a:hover { color: rgb(var(--ink)); }
.foot-legal { margin-top: 44px; padding-top: 22px; border-top: 1px solid rgb(var(--line)); font-size: 13.5px; }

/* sticky mobile bar */
.sticky-bar { position: fixed; inset: auto 12px 12px; z-index: 55; display: flex; gap: 8px; padding: 8px; border-radius: 999px; background: #ffffffd9; backdrop-filter: blur(14px); box-shadow: 0 16px 40px -14px #11141288; padding-bottom: max(8px, env(safe-area-inset-bottom)); }
.sticky-bar .btn-studio { flex: 1; }
.sticky-wa { display: grid; place-items: center; width: 56px; flex: none; border-radius: 50%; background: rgb(var(--surface-2)); }
@media (min-width: 900px) { .sticky-bar { display: none; } }

/* modal + lightbox */
.overlay { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; background: #111412b8; backdrop-filter: blur(6px); }
@media (min-width: 640px) { .overlay { align-items: center; padding: 24px; } }
.modal { width: 100%; max-width: 520px; max-height: 92dvh; overflow-y: auto; padding: 26px; border-radius: 30px 30px 0 0; background: rgb(var(--bg)); color: rgb(var(--ink)); box-shadow: 0 40px 80px -30px #000a; }
@media (min-width: 640px) { .modal { border-radius: 30px; } }
.modal-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
.modal-kicker { color: rgb(var(--muted)); font-size: 14px; font-weight: 600; }
.modal-title { margin-top: 2px; font: 800 26px / 1.05 var(--font-display); letter-spacing: -.035em; }
.modal-title small { font: 500 15px var(--font-body); letter-spacing: 0; color: rgb(var(--muted)); }
.close-btn { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: rgb(var(--surface-2)); transition: background-color .2s; }
.close-btn:hover { background: rgb(var(--line)); }
.progress { display: flex; gap: 6px; margin-bottom: 22px; }
.progress div { flex: 1; }
.progress i { display: block; height: 4px; border-radius: 4px; background: rgb(var(--line)); transition: background-color .3s; }
.progress i.on { background: rgb(var(--ink)); }
.progress p { margin-top: 6px; font-size: 12.5px; font-weight: 600; color: rgb(var(--muted)); }
.progress .cur { color: rgb(var(--ink)); }
.field { display: block; width: 100%; padding: 16px 18px; border-radius: 16px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); font: inherit; font-size: 16px; color: rgb(var(--ink)); border: 0; outline: 0; transition: box-shadow .2s; }
.field::placeholder { color: rgb(var(--muted) / .7); }
.field:focus { box-shadow: inset 0 0 0 2px rgb(var(--ink)); }
.form-stack { display: grid; gap: 12px; }
.err-box { margin-top: 14px; padding: 12px 16px; border-radius: 14px; background: #c42b1c14; box-shadow: inset 0 0 0 1px #c42b1c40; color: #a52114; font-size: 14.5px; }
.card-soft { padding: 18px; border-radius: 20px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)); font-size: 15px; }
.row-kv { display: flex; justify-content: space-between; gap: 16px; padding: 4px 0; }
.row-kv span:first-child { color: rgb(var(--muted)); }
.row-kv span:last-child { text-align: right; font-weight: 600; }
.modal-actions { display: flex; gap: 10px; margin-top: 22px; }
.btn-back { display: inline-flex; align-items: center; gap: 8px; min-height: 56px; padding: 0 22px; border-radius: 999px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1.5px rgb(var(--ink) / .16); font-weight: 600; }
.modal-actions .btn-studio { flex: 1; }
.lightbox { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 16px; background: #111412e6; backdrop-filter: blur(8px); }
.lightbox-close { position: absolute; top: 16px; right: 16px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: #ffffff1f; color: #fff; }
.lightbox-box { width: 100%; overflow: hidden; border-radius: 26px; background: #000; }
.lightbox-cap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; color: #fff; background: #1d1d1b; }

/* ---------- Responsive ---------- */
@media (max-width: 899px) {
  .tiles, .season-grid, .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .quotes { grid-template-columns: 1fr; }
  .quotes > li:first-child { grid-row: auto; }
  .why-wrap { grid-template-columns: 1fr; }
  .offers { grid-template-columns: 1fr; }
}
@media (max-width: 639px) {
  .tiles, .season-grid, .steps { grid-template-columns: 1fr; }
  .site-foot { padding-bottom: 110px; }
  .h-section { max-width: none; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-bg::before, .hero-bg::after, .seasons::before, .final::before, .final::after, .marquee-track, .event-dot { animation: none; }
  .h-hero > span { animation: none; }
  .note path { animation: none; stroke-dashoffset: 0; }
}

/* make animated wrappers inside grids fill their cell */
.tile-wrap, .step-wrap, .quote-wrap { display: flex; flex: 1; width: 100%; }
.tile-wrap > *, .step-wrap > *, .quote-wrap > * { width: 100%; }

/* phones: the sticky bottom bar carries the main button, so the nav only needs brand + menu */
@media (max-width: 639px) {
  .site-actions .btn-studio { display: none; }
}

/* ---------- lightweight animations (replace the old animation library) ---------- */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
.reveal.is-in { opacity: 1; transform: none; }
.fold { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s var(--ease-out); }
.fold.is-open { grid-template-rows: 1fr; }
.fold > div { min-height: 0; overflow: hidden; }
@keyframes pop-in { from { opacity: 0; transform: translateY(12px) scale(.96); } to { opacity: 1; transform: none; } }
@keyframes slide-in { from { opacity: 0; transform: translateY(40px) scale(.98); } to { opacity: 1; transform: none; } }
@keyframes step-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
@keyframes rise-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
.anim-pop { animation: pop-in .3s var(--ease-out) both; }
.anim-slide { animation: slide-in .35s var(--ease-out) both; }
.anim-step { animation: step-in .22s var(--ease-out) both; }
.anim-rise { animation: rise-in .4s var(--ease-out) both; }
@media (prefers-reduced-motion: reduce) {
  .reveal { transform: none; transition: opacity .3s; }
  .fold { transition: none; }
  .anim-pop, .anim-slide, .anim-step, .anim-rise { animation: none; }
}

/* ---------- country switcher ---------- */
.country { position: relative; }
.country-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; border-radius: 999px; background: #1114120f; font: 600 14px / 1 var(--font-body); transition: background-color .2s; }
.country-btn:hover { background: #11141420; }
.country-btn svg { opacity: .6; }
.country-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 70; min-width: 230px; padding: 6px; border-radius: 20px; background: #fffffff2; backdrop-filter: blur(14px); box-shadow: 0 24px 50px -20px #11141299, inset 0 0 0 1px rgb(var(--line)); }
.country-menu button { display: flex; width: 100%; align-items: center; gap: 10px; min-height: 46px; padding: 0 12px; border-radius: 14px; text-align: left; font-weight: 600; font-size: 15px; }
.country-menu button:hover { background: rgb(var(--surface-2)); }
.country-menu button[aria-selected="true"] { background: rgb(var(--ink)); color: #fff; }
.country-menu small { margin-left: auto; opacity: .55; font-weight: 600; font-size: 12px; }

/* ---------- client badge + spotlight ---------- */
.client-badge { display: inline-flex; align-items: center; gap: 10px; max-width: 100%; margin-top: 18px; padding: 5px 16px 5px 5px; border-radius: 999px; background: #ffffffb8; backdrop-filter: blur(8px); box-shadow: inset 0 0 0 1.5px #11141218; font-size: 14px; color: rgb(var(--ink-2)); text-align: left; transition: background-color .2s, transform .35s var(--ease-out); }
.client-badge:hover { background: #fff; transform: translateY(-2px); }
.client-badge img { flex: none; width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
.client-badge strong { color: rgb(var(--ink)); }
.spotlight { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; padding: clamp(28px, 4.5vw, 64px); border-radius: 36px; background: linear-gradient(135deg, rgb(var(--mint)), #fbfffc 85%); box-shadow: inset 0 0 0 1px rgb(var(--line)); }
.spot-logo-wrap { display: flex; width: 100%; }
.spot-logo { width: 100%; max-width: 300px; aspect-ratio: 1; overflow: hidden; border-radius: 32px; background: #12a36a; box-shadow: 0 30px 60px -30px #0b5a3a99, 0 0 0 6px #ffffffb3; transform: rotate(-2deg); transition: transform .6s var(--ease-out); }
.spotlight:hover .spot-logo { transform: rotate(0deg) scale(1.02); }
.spot-logo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.spot-copy { display: block; }
.spot-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px; }
.spot-badge { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; background: rgb(var(--ink)); color: #fff; font-size: 14px; font-weight: 700; }
.spot-badge svg { color: rgb(var(--brand)); }
.spot-points { display: grid; gap: 10px; margin-top: 22px; }
.spot-points li { display: flex; align-items: flex-start; gap: 10px; font-weight: 600; font-size: 16.5px; }
.spot-points svg { flex: none; margin-top: 2px; color: #0d8a5a; }
.spot-videos { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; padding-top: 8px; }
@media (max-width: 899px) { .spotlight { grid-template-columns: 1fr; text-align: left; } .spot-logo { max-width: 220px; } }

/* ---------- events extras ---------- */
.season-caption { margin-top: 30px; font-weight: 700; font-size: 15px; color: rgb(var(--ink-2)); }
.season-order { margin-top: 2px; color: rgb(var(--accent)) !important; }

/* ---------- order form extras ---------- */
.field-label { display: block; margin: 0 0 -4px 4px; font-size: 13px; font-weight: 700; color: rgb(var(--muted)); }
.check-row { display: flex; align-items: flex-start; gap: 10px; padding: 4px 4px 0; font-size: 14px; line-height: 1.4; color: rgb(var(--ink-2)); cursor: pointer; }
.check-row input { flex: none; width: 20px; height: 20px; margin-top: 1px; accent-color: rgb(var(--ink)); }
.check-row small { color: rgb(var(--muted)); }

/* ---------- "just started" pop-ups ---------- */
.live-toast { position: fixed; left: 16px; bottom: 16px; z-index: 54; display: flex; align-items: center; gap: 12px; max-width: min(380px, calc(100vw - 32px)); padding: 10px 10px 10px 12px; border-radius: 22px; background: #fffffff2; backdrop-filter: blur(14px); box-shadow: 0 24px 50px -20px #11141299, inset 0 0 0 1px rgb(var(--line)); }
.live-avatar { display: grid; place-items: center; flex: none; width: 42px; height: 42px; border-radius: 14px; background: rgb(var(--mint)); font: 800 17px var(--font-display); }
.live-toast p { font-size: 14.5px; line-height: 1.35; }
.live-toast p span:last-child { display: block; color: rgb(var(--muted)); font-size: 13px; }
.live-close { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; color: rgb(var(--muted)); transition: background-color .2s; }
.live-close:hover { background: rgb(var(--surface-2)); }
@media (max-width: 899px) { .live-toast { left: 12px; right: 12px; bottom: 88px; max-width: none; } }

/* long call-to-action wording (wraps onto two lines instead of overflowing on phones) */
.btn-studio.is-wrap { white-space: normal; text-align: left; line-height: 1.25; padding: 8px 8px 8px 24px; max-width: min(100%, 540px); }
.btn-studio.is-wrap > span:first-child { flex: 1; }

/* ---------- cost-comparison card ("What AI replaces") ---------- */
.cost-sec { padding-top: 0; }
.cost-label { margin-bottom: 14px; color: rgb(var(--muted)); font: 500 13px / 1.3 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
.cost-card { max-width: 720px; margin-inline: auto; padding: clamp(24px, 4vw, 40px); border-radius: 32px; background: rgb(var(--surface)); box-shadow: inset 0 0 0 1px rgb(var(--line)), 0 40px 60px -50px #11141255; }
.cost-card h3 { font: 800 clamp(26px, 3.4vw, 34px) / 1.05 var(--font-display); letter-spacing: -.035em; }
.cost-row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-top: 22px; }
.cost-row span { color: rgb(var(--ink-2)); font-size: 16px; }
.cost-row strong { font: 800 clamp(20px, 3vw, 26px) / 1 var(--font-display); letter-spacing: -.03em; text-align: right; }
.cost-bar { height: 18px; margin-top: 10px; border-radius: 999px; background: rgb(var(--surface-2)); overflow: hidden; }
.cost-bar > i { display: block; height: 100%; min-width: 18px; border-radius: 999px; background: #c3c4bc; }
.cost-bar.is-ours > i { background: rgb(var(--brand)); transform-origin: left; animation: bar-grow 1.1s var(--ease-out) both; }
@keyframes bar-grow { from { transform: scaleX(0); } to { transform: none; } }
